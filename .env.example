# Public canonical URL. Cloudflare Tunnel should route this hostname to http://127.0.0.1:3000.
APP_URL=https://impact.renfrewcountyscanner.com

# Generate each value with: openssl rand -base64 48
POSTGRES_DB=impact
POSTGRES_USER=impact
POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-secret
IP_HASH_SECRET=replace-with-a-separate-long-random-secret

# Private service URL; this is never exposed to browsers.
NOMINATIM_SEARCH_URL=http://192.168.90.115/nominatim/search
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Leave empty until Cloudflare Turnstile is configured. Production fails closed without them.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Allowed only while NODE_ENV=development.
DEVELOPMENT_TURNSTILE_BYPASS=false

